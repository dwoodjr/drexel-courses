		{"id":"448dce75d2084e2e","type":"file","file":"DIGM 553/Week 02 - Construct Conditions for Speculative Pragmatism/media/IMG_6597.jpeg","x":-2197,"y":350,"width":375,"height":500},
		{"id":"5a33fac1a132c7bf","type":"text","text":"DIY Hydrophone","x":-2500,"y":200,"width":708,"height":50,"color":"4"},
		{"id":"607937b2c39fb13a","type":"text","text":" What does it resist?","x":-745,"y":320,"width":250,"height":60,"color":"2"},
		{"id":"18955feeb81388fa","type":"text","text":"What is it?","x":-800,"y":-130,"width":250,"height":50,"color":"1"},
		{"id":"d972821125827466","type":"text","text":"What does it open?","x":-620,"y":100,"width":250,"height":60,"color":"1"},
		{"id":"f2c2ba51b0c84c7b","type":"file","file":"DIGM 553/Week 02 - Construct Conditions for Speculative Pragmatism/media/IDG_20260406_114518_273.jpg","x":-2197,"y":1058,"width":360,"height":480},
		{"id":"ebf58cb3639abf76","type":"text","text":"A bath bomb-style compressed substrate: made from baking soda, citric acid, cornstarch, clay, salt, and iron oxide pigment. \n","x":-1837,"y":1058,"width":250,"height":152},
		{"id":"11f97fc245491541","type":"file","file":"DIGM 553/Week 02 - Construct Conditions for Speculative Pragmatism/media/IDG_20260405_224124_714.jpg","x":-2560,"y":1163,"width":363,"height":272},
		{"id":"ba6447cbc095836f","type":"text","text":"The sphere is structurally stable in dry conditions","x":-1837,"y":1257,"width":250,"height":83},
		{"id":"d4223ae84a4a0cb7","type":"text","text":"Water. Heat. Time.","x":-1837,"y":1370,"width":250,"height":60},
		{"id":"35d8712cd81ef598","type":"text","text":"*Atmospheric sound.*  It is more “optimized” for the acoustic properties of water.","x":-1817,"y":350,"width":250,"height":120},
		{"id":"d412d79a98b577a8","type":"link","url":"https://zoomcorp.com/media/original_images/H5studio-2-Hero2.png.768x0_q60.png","x":-2260,"y":-430,"width":468,"height":562},
		{"id":"63ceafa09e334cd6","type":"text","text":"What is it thinking?","x":-250,"y":100,"width":250,"height":60,"color":"1"},
		{"id":"e958517d5f34ad1b","type":"text","text":"What does it yield to?","x":-375,"y":330,"width":250,"height":50,"color":"2"},
		{"id":"subA","type":"file","file":"DIGM 553/Week 02 - Construct Conditions for Speculative Pragmatism/submodules/DIGM 553 - W02A - (Im)material Potluck.md","x":-495,"y":-510,"width":420,"height":450,"color":"6"},
		{"id":"subB","type":"file","file":"DIGM 553/Week 02 - Construct Conditions for Speculative Pragmatism/submodules/DIGM 553 - W02B - Enabling Constraints Workshop.md","x":-3434,"y":-549,"width":420,"height":519,"color":"3"},
		{"id":"9c9c004e4f86d541","type":"text","text":"Zoom H5 Studio “Handy” Recorder","x":-2500,"y":-549,"width":678,"height":60,"color":"4"},
		{"id":"78e3fc1ffaeb4b93","type":"text","text":"What does it already know?","x":-60,"y":330,"width":250,"height":60,"color":"2"},
		{"id":"0cbcd6c72c600544","type":"text","text":"WORKS IN CONVERSATION ","x":-612,"y":1080,"width":242,"height":60,"color":"6"},
		{"id":"06f0d4efb1d8664a","type":"text","text":"Pressure waves propagating through liquid","x":-1817,"y":490,"width":250,"height":60},
		{"id":"780cad1f95febc42","type":"text","text":"That sound can travel through a medium that isn't air. That water has its own acoustic logic.","x":-1817,"y":590,"width":250,"height":121},
		{"id":"f105aef47f5c8b82","type":"text","text":"It's designed to capture sound *above* water, through air.","x":-1792,"y":-430,"width":250,"height":116},
		{"id":"6a25696aadf58544","type":"text","text":"It yields to its polar pattern + frequency response curve.","x":-1792,"y":-291,"width":250,"height":83},
		{"id":"f39b690230ba16ec","type":"text","text":"That sound is something that *can* move through air: \n- sound has amplitude (physical) \n- sound has frequency (physical)\n- sound has wavelength (physical)\n- sound can be captured as a voltage signal (physical → digital)","x":-1792,"y":-192,"width":250,"height":324},
		{"id":"thread_Collective_Practice","type":"file","file":"DIGM 553/Threads/Collective Practice.md","x":-3600,"y":-1520,"width":300,"height":480,"color":"5"},
		{"id":"thread_Physical_Digital_Entanglement","type":"file","file":"DIGM 553/Threads/Physical-Digital Entanglement.md","x":-4080,"y":-1520,"width":300,"height":480,"color":"5"},
		{"id":"thread_Research_Creation","type":"file","file":"DIGM 553/Threads/Research-Creation.md","x":-1120,"y":-1560,"width":300,"height":480,"color":"5"},
